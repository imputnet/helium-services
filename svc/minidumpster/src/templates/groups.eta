<% layout('layout') %>

<form class="filters" method="get" action="/" data-autosubmit>
  <%~ include('select', { name: 'product', values: it.options.products, selected: it.filter.product }) %>
  <%~ include('select', { name: 'version', values: it.options.versions, selected: it.filter.version }) %>
  <%~ include('select', { name: 'platform', values: it.options.platforms, selected: it.filter.platform }) %>
  <%~ include('select', { name: 'ptype', values: it.options.ptypes, selected: it.filter.ptype }) %>
  <input type="hidden" name="breakdown" value="<%= it.chart.breakdown %>">
  <input type="hidden" name="sort" value="<%= it.sort %>">
  <button class="control apply">apply</button>
</form>

<%~ include('reports-chart', { chart: it.chart, filter: it.filter, action: '/' }) %>

<div class="overflow">
<table class="groups">
  <thead>
    <tr>
      <th>signature</th>
      <th class="num"<%~ it.sort === 'count' ? ' aria-sort="descending"' : '' %>><a href="<%= it.countHref %>">reports<%= it.sort === 'count' ? ' ↓' : '' %></a></th>
      <th>versions</th>
      <th>platforms</th>
      <th>first seen</th>
      <th<%~ it.sort === 'last_seen' ? ' aria-sort="descending"' : '' %>><a href="<%= it.lastSeenHref %>">last seen<%= it.sort === 'last_seen' ? ' ↓' : '' %></a></th>
    </tr>
  </thead>
  <tbody>
    <% if (it.groups.length === 0) { %>
    <tr><td colspan="6" class="muted">No crash groups yet.</td></tr>
    <% } %>
    <% it.groups.forEach((g) => { %>
    <tr>
      <td>
        <a href="/groups/<%= g.id %>" class="mono"><%~ include('cpp-name', { name: g.title, collapseCppName: it.collapseCppName }) %></a>
        <% if (g.unsymbolicated > 0) { %>
        <span class="pill pill-warn" title="<%= g.unsymbolicated %> report(s) without symbols">missing symbols</span>
        <% } %>
      </td>
      <td class="num"><%= g.report_count %></td>
      <td><div class="tags"><% g.versions.forEach((v) => { %><span class="pill"><%= v %></span><% }) %></div></td>
      <td><div class="tags"><% g.platforms.forEach((p) => { %><span class="pill"><%= p %></span><% }) %></div></td>
      <td class="time"><%= it.fmtTime(g.first_seen) %></td>
      <td class="time"><%= it.fmtTime(g.last_seen) %></td>
    </tr>
    <% }) %>
  </tbody>
</table>
</div>
