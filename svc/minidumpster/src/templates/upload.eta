<% layout('layout') %>
<h1>Symbolicate a macOS crash report</h1>
<p class="muted">
  Paste the "Translated Report" text from Console.app or the crash dialog
  (or attach the .crash file). It is symbolicated against the uploaded
  symbols and filed as a report; re-uploading the same incident opens the
  existing report.
</p>
<% if (it.error) { %><p class="warn"><%= it.error %></p><% } %>
<form class="upload" method="post" action="/upload" enctype="multipart/form-data">
  <textarea name="text" rows="16" aria-label="crash report text" placeholder="Process:             Helium [9625]&#10;..."></textarea>
  <div class="actions">
    <input type="file" name="file" aria-label="crash report file">
    <button type="submit" class="control primary">symbolicate</button>
  </div>
</form>
