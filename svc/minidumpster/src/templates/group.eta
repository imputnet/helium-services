<% layout('layout') %>

<div class="crumbs"><a href="/">← all groups</a></div>

<h2 class="mono"><%~ include('cpp-name', { name: it.group.title, collapseCppName: it.collapseCppName }) %></h2>
<p class="muted">
  <%= it.group.report_count %> reports
  · first seen <%= it.fmtTime(it.group.first_seen) %>
  · last seen <%= it.fmtTime(it.group.last_seen) %>
  · signature <code><%= it.group.signature.slice(0, 16) %>…</code>
</p>

<%~ include('reports-chart', { chart: it.chart, filter: {}, action: '/groups/' + it.group.id }) %>

<div class="actions">
  <form method="post" action="/groups/<%= it.group.id %>/reprocess"
        data-confirm="Reprocess all <%= it.group.report_count %> reports in this group?">
    <button type="submit">Reprocess group</button>
  </form>
  <form method="post" action="/groups/<%= it.group.id %>/delete"
        data-confirm="Delete this group and all <%= it.group.report_count %> reports?">
    <button type="submit" class="danger">Delete group</button>
  </form>
</div>

<% if (it.latestStack) { %>
<h2>
  Latest stack
  <span class="muted">(report <a href="/reports/<%= it.latestStack.reportId %>" class="mono"><%= it.latestStack.reportId.slice(0, 8) %></a>)</span>
</h2>
<%~ it.latestStack.html %>
<% } %>

<h2>Recent reports</h2>
<%~ include('reports-table', { reports: it.reports, fmtTime: it.fmtTime }) %>
