<% layout('layout') %>

<nav class="crumbs"><a href="/">crash reports</a><span>/</span><span>group</span></nav>
<h1><span class="mono"><%~ include('cpp-name', { name: it.group.title, collapseCppName: it.collapseCppName }) %></span></h1>

<div class="stats">
  <div><span>reports</span><strong><%= it.group.report_count %></strong></div>
  <div><span>first seen</span><strong><%= it.fmtTime(it.group.first_seen) %></strong></div>
  <div><span>last seen</span><strong><%= it.fmtTime(it.group.last_seen) %></strong></div>
  <div><span>signature</span><strong class="mono" title="<%= it.group.signature %>"><%= it.group.signature %></strong></div>
</div>

<div class="actions">
  <form method="post" action="/groups/<%= it.group.id %>/reprocess"
        data-confirm="Reprocess all <%= it.group.report_count %> reports in this group?">
    <button type="submit" class="control">reprocess group</button>
  </form>
  <form method="post" action="/groups/<%= it.group.id %>/delete"
        data-confirm="Delete this group and all <%= it.group.report_count %> reports?">
    <button type="submit" class="control danger">delete group</button>
  </form>
</div>

<%~ include('reports-chart', { chart: it.chart, filter: {}, action: '/groups/' + it.group.id }) %>

<% if (it.latestStack) { %>
<h2>
  Latest stack
  <a href="/reports/<%= it.latestStack.reportId %>" class="pill mono"><%= it.latestStack.reportId.slice(0, 8) %></a>
</h2>
<%~ it.latestStack.html %>
<% } %>

<h2>Recent reports</h2>
<%~ include('reports-table', { reports: it.reports, fmtTime: it.fmtTime }) %>
