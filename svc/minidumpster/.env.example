# GitHub OAuth app, callback URL: $PUBLIC_BASE_URL/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Only active members of this GitHub org may use the web UI.
GITHUB_ORG=
# GitHub token with read access to Actions artifacts; enables the Helium crawler.
GITHUB_ARTIFACT_TOKEN=

PUBLIC_BASE_URL=https://crash.helium.computer

# openssl rand -hex 32
SESSION_SECRET=
SYMBOL_UPLOAD_TOKEN=

#PORT=8080
#MAX_DUMP_SIZE_MB=20
#RETENTION_DAYS=30
# days to keep symbols per build (by upload time); 0 keeps them forever
#SYMBOLS_RETENTION_DAYS=180
# Ignore GitHub Actions artifacts older than this many days.
#ARTIFACT_CRAWLER_MAX_AGE_DAYS=7

## change to $(id -u) and $(id -g) if your ids are not 1000
#APP_UID=1000
#APP_GID=1000
