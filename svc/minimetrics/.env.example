# GitHub OAuth app, callback URL: $PUBLIC_BASE_URL/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Only active members of this GitHub org may use the web UI.
GITHUB_ORG=

PUBLIC_BASE_URL=https://metrics.helium.computer

# openssl rand -hex 32
SESSION_SECRET=
NAMES_UPLOAD_TOKEN=

#PORT=8080
# limit for a single decompressed log
#MAX_LOG_SIZE_MB=10
# days to keep aggregates and daily user counts
#RETENTION_DAYS=90
#RATE_LIMIT_PER_MINUTE=30
# only show histogram data for filters matching at least this many daily users
#MIN_USERS=5
# newline-separated histogram names; when set, everything else is dropped.
# the path is inside the container, so mount the file into /data.
#HISTOGRAM_ALLOWLIST=/data/allowlist.txt

## change to $(id -u) and $(id -g) if your ids are not 1000
#APP_UID=1000
#APP_GID=1000
